@model IEnumerable<Patient>


<h2>Patients</h2>
<a asp-action="Create">Add New Patient</a>


<table class="table">
    <tr>
        <th>Name</th>
        <th>Age</th>
        <th>Gender</th>
        <th>Disease</th>
    </tr>
    @foreach (var p in Model)
    {
        <tr>
            <td>@p.Name</td>
            <td>@p.Age</td>
            <td>@p.Gender</td>
            <td>@p.Disease</td>
        </tr>
    }
</table>